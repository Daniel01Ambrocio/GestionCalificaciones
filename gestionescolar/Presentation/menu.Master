<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="menu.master.cs" Inherits="gestionescolar.Presentation.menu" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>Gestión Escolar</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- CSS propio -->
    <link rel="stylesheet" href="../Styles/menu.css" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server" class="d-flex flex-column flex-lg-row min-vh-100">

        <!-- Sidebar -->
        <div class="sidebar p-3 d-flex flex-column flex-shrink-0">
            <!-- Logo -->
            <img src="<%= ResolveUrl("~/Content/logo.png") %>" alt="Logo" class="img-fluid mb-3" style="max-width:150px;" />

            <!-- Usuario y rol -->
            <div class="user-info mb-4">
                <asp:Label ID="lbUsuario" runat="server" Text="Usuario: demoUser" CssClass="d-block fw-bold" />
                <asp:Label ID="lbRol" runat="server" Text="Rol: Admin" CssClass="text-muted" />
            </div>

            <!-- Navegación -->
            <nav class="nav flex-column mb-3">
                <asp:HyperLink ID="datosEscuela" CssClass="nav-link" NavigateUrl="DatosEscuela.aspx" Text="Datos de la escuela" runat="server" />
                <asp:HyperLink ID="registroUsuarios" CssClass="nav-link" NavigateUrl="RegistroUsuarios.aspx" Text="Registrar usuario" runat="server" />
                <asp:HyperLink ID="misCalificaciones" CssClass="nav-link" NavigateUrl="MisCalificaciones.aspx" Text="Mis calificaciones" runat="server" />
                <asp:HyperLink ID="asignarCalificacion" CssClass="nav-link" NavigateUrl="AsignarCalificacion.aspx" Text="Asignar/calificar alumno" runat="server" />
                <asp:HyperLink ID="solicitarBaja" CssClass="nav-link" NavigateUrl="SolicitudBaja.aspx" Text="Solicitar baja de alumno o maestro" runat="server" />
                <asp:HyperLink ID="imprimirBoleta" CssClass="nav-link" NavigateUrl="ImprimirBoleta.aspx" Text="Imprimir boleta de calificaciones" runat="server" />
                <asp:HyperLink ID="registrarMateria" CssClass="nav-link" NavigateUrl="RegistrarMateria.aspx" Text="Registrar/ver materia" runat="server" />
                <asp:HyperLink ID="autorizarBajas" CssClass="nav-link" NavigateUrl="AutorizarBajas.aspx" Text="Autorizar bajas" runat="server" />
                <asp:HyperLink ID="bajaAdministrativos" CssClass="nav-link" NavigateUrl="BajaAdministrativo.aspx" Text="Dar de baja administrativos" runat="server" />
                <asp:HyperLink ID="listaGrupos" CssClass="nav-link" NavigateUrl="RegistrarVerGrupos.aspx" Text="Registrar/ver grupos" runat="server" />
                <asp:HyperLink ID="listaAlumnos" CssClass="nav-link" NavigateUrl="ListaEditAlumnos.aspx" Text="Lista de alumnos" runat="server" />
                <asp:HyperLink ID="listaMaestros" CssClass="nav-link" NavigateUrl="ListaMaestros.aspx" Text="Lista de maestros" runat="server" />
                <asp:HyperLink ID="listaAdministrativos" CssClass="nav-link" NavigateUrl="ListaAdministrativos.aspx" Text="Lista de administrativos" runat="server" />
                <asp:HyperLink ID="ListaDirectoresV" CssClass="nav-link" NavigateUrl="ListaDirectores.aspx" Text="Lista de directores" runat="server" />
            </nav>

            <!-- Configuración -->
            <hr />
            <asp:HyperLink CssClass="nav-link cambiar-contrasena" NavigateUrl="CambiarContrasena.aspx"  Text="⚙ Cambiar contraseña" runat="server" />

           <asp:Button ID="btnCerrarSesion" runat="server" Text="⏻ Cerrar sesión" CssClass="btn btn-outline-danger mt-2" OnClick="btnCerrarSesion_Click" />
        </div>

        <!-- Contenido principal -->
        <div class="main-content flex-grow-1 p-3">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </div>

    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
