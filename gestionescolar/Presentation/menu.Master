<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="menu.master.cs" Inherits="gestionescolar.Presentation.menu" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>Gestión Escolar</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <!-- CSS propio -->
    <link rel="stylesheet" href="../Styles/menu.css" />
    <link rel="stylesheet" href="../Styles/Animaciones.css" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server" class="d-flex flex-column flex-lg-row min-vh-100">

        <!-- Sidebar -->
        <div class="sidebar p-3 d-flex flex-column flex-shrink-0">
            <!-- Logo -->
            <img src="<%= ResolveUrl("~/Content/logo.png") %>" alt="Logo" class="img-fluid mb-3" style="max-width: 70px;" />

            <!-- Usuario y rol -->
            <div class="user-info mb-4">
                <asp:Label ID="lbUsuario" runat="server" Text="Usuario: demoUser" CssClass="d-block fw-bold" />
                <asp:Label ID="lbRol" runat="server" Text="Rol: Admin" CssClass="text-muted" />
            </div>

            <!-- Navegación -->
            <nav class="nav flex-column mb-3">
                <asp:HyperLink
                    ID="datosEscuela"
                    CssClass="nav-link "
                    NavigateUrl="DatosEscuela.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoEscuela.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Datos de la escuela
                </asp:HyperLink>

                <asp:HyperLink
                    ID="registroUsuarios"
                    CssClass="nav-link"
                    NavigateUrl="RegistroUsuarios.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoRegUsuario.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Registrar usuario
                </asp:HyperLink>
                <asp:HyperLink
                    ID="misCalificaciones"
                    CssClass="nav-link"
                    NavigateUrl="MisCalificaciones.aspx"
                    Text=""
                    runat="server">
                    <img src="../Content/Icons/iconoMisCalificaciones.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Mis calificaciones
                </asp:HyperLink>
                <asp:HyperLink
                    ID="asignarCalificacion"
                    CssClass="nav-link"
                    NavigateUrl="AsignarCalificacion.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoRegCalificaciones.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Calificar alumno
                </asp:HyperLink>
                <asp:HyperLink
                    ID="solicitarBaja"
                    CssClass="nav-link"
                    NavigateUrl="SolicitudBaja.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoSolicitudBaja.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Solicitar baja de alumno o maestro
                </asp:HyperLink>
                <asp:HyperLink
                    ID="imprimirBoleta"
                    CssClass="nav-link"
                    NavigateUrl="ImprimirBoleta.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoImpBoleta.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Imprimir boleta de calificaciones
                </asp:HyperLink>
                <asp:HyperLink
                    ID="registrarMateria"
                    CssClass="nav-link"
                    NavigateUrl="RegistrarMateria.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoRegMateria.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Registrar/ver materia
                </asp:HyperLink>
                <asp:HyperLink
                    ID="autorizarBajas"
                    CssClass="nav-link"
                    NavigateUrl="AutorizarBajas.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoAutBajas.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Autorizar bajas
                </asp:HyperLink>
                <asp:HyperLink
                    ID="bajaAdministrativos"
                    CssClass="nav-link"
                    NavigateUrl="BajaAdministrativo.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoBorrAdministrativo.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Dar de baja administrativos
                </asp:HyperLink>
                <asp:HyperLink
                    ID="listaGrupos"
                    CssClass="nav-link"
                    NavigateUrl="RegistrarVerGrupos.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoRegGrupos.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Registrar/ver grupos
                </asp:HyperLink>
                <asp:HyperLink
                    ID="listaAlumnos"
                    CssClass="nav-link"
                    NavigateUrl="ListaEditAlumnos.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoListAlumnos.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Lista de alumnos
                </asp:HyperLink>
                <asp:HyperLink
                    ID="listaMaestros"
                    CssClass="nav-link"
                    NavigateUrl="ListaMaestros.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoListMaestros.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Lista de maestros
                </asp:HyperLink>
                <asp:HyperLink
                    ID="listaAdministrativos"
                    CssClass="nav-link"
                    NavigateUrl="ListaAdministrativos.aspx"
                    Text=""
                    runat="server">
                    <img src="../Content/Icons/iconoListAdministrativos.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Lista de administrativos
                </asp:HyperLink>
                <asp:HyperLink
                    ID="ListaDirectoresV"
                    CssClass="nav-link"
                    NavigateUrl="ListaDirectores.aspx"
                    runat="server">
                    <img src="../Content/Icons/iconoListDirectores.png" 
                        alt="Escuela" 
                        class="IconMenu" />
                    Lista de directores
                </asp:HyperLink>
            </nav>

            <!-- Configuración -->
            <hr />
            <asp:HyperLink CssClass="nav-link cambiar-contrasena" NavigateUrl="CambiarContrasena.aspx" Text="⚙ Cambiar contraseña" runat="server" />

            <asp:Button ID="btnCerrarSesion" runat="server" Text="⏻ Cerrar sesión" CssClass="btn btn-outline-danger mt-2" OnClick="btnCerrarSesion_Click" />
        </div>

        <!-- Contenido principal -->
        <div class="main-content flex-grow-1 p-3">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </div>

    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
